{
  "name": "product-automation",
  "version": "0.1.0",
  "private": true,
  "description": "WebdriverIO + Mocha regression tests for the Product app",
  "type": "module",
  "scripts": {
    "postinstall": "node ./scripts/patch-bs-preprod.mjs",
    "patch:preprod": "node ./scripts/patch-bs-preprod.mjs",
    "test": "wdio run ./wdio.conf.js",
    "test:regression": "wdio run ./wdio.conf.js --suite regression",
    "test:smoke": "wdio run ./wdio.conf.js --suite smoke",
    "test:bs": "wdio run ./wdio.browserstack.conf.js",
    "test:bs:smoke": "wdio run ./wdio.browserstack.conf.js --suite smoke",
    "test:bs:regression": "wdio run ./wdio.browserstack.conf.js --suite regression"
  },
  "devDependencies": {
    "@wdio/browserstack-service": "^9.2.8",
    "@wdio/cli": "^9.2.8",
    "@wdio/local-runner": "^9.2.8",
    "@wdio/mocha-framework": "^9.2.8",
    "@wdio/spec-reporter": "^9.2.8",
    "chai": "^5.1.2",
    "dotenv": "^16.4.5"
  }
}
